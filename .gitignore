# Bazel symlinks
/bazel-*

# Bazel disk cache / user config
.bazelrc.user

# Hermit-managed toolchain lives in /bin (stubs + .hcl are committed).
# Ignore only Hermit's local env state/cache, never the checked-in stubs.
/bin/.hermit/

# Go build & test artifacts
*.test
*.out
*.exe

# Editor / OS junk
.DS_Store
